{
  "name": "pi-permission-layers",
  "version": "1.5.0",
  "description": "Pi extension to handle permissions using a layered approach",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "permission"
  ],
  "files": [
    "src/**"
  ],
  "author": "Gabriel Sanhueza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsanhueza/pi-permission-layers.git"
  },
  "homepage": "https://github.com/gsanhueza/pi-permission-layers#readme",
  "bugs": {
    "url": "https://github.com/gsanhueza/pi-permission-layers/issues"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "type": "module",
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1"
  },
  "dependencies": {
    "shell-quote": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/shell-quote": "^1.7.5",
    "@vitest/coverage-v8": "^5.0.5",
    "prettier-plugin-organize-imports": "^4.3.0",
    "vitest": "^5.0.5"
  }
}
